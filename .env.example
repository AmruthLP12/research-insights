# ==============================================================================
# RRI Publications Dashboard (.env.example)
# Copy this file to .env and adjust values for your environment.
# Never commit real secrets or production .env files to version control.
# ==============================================================================

# --- Core Django Security & Environment Settings ---

# DEBUG: Explicit boolean flag ('True' for local development, 'False' in production).
# Defaults to False if unset or empty.
DEBUG=True

# DJANGO_SECRET_KEY: Cryptographic signing secret.
# In production (DEBUG=False): REQUIRED. Must be a secure, random string (min 50 chars)
# and must NOT start with 'django-insecure-'.
# In development (DEBUG=True): A fixed development key is acceptable (e.g. this placeholder or the built-in local dev fallback).
DJANGO_SECRET_KEY=django-insecure-development-placeholder-change-in-production

# ALLOWED_HOSTS: Comma-separated list of host/domain names this site can serve.
# In production (DEBUG=False): REQUIRED. Must be explicitly specified (e.g. 'example.com,www.example.com').
# Wildcards ('*') are strictly rejected in production.
# In development (DEBUG=True): Defaults to 'localhost,127.0.0.1,[::1]' if empty.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],example.com

# --- Application Server & Build Settings (Used by Makefile / Local Server) ---
PORT=9000
HOST=0.0.0.0
DOMAIN=example.com
SITE_NAME=pub
VENV=venv

# --- Metadata / Deployment Information ---
APP_ENV=Development
APP_VERSION=1.0.0
BUILD_DATE=30-01-2026
SITE_FULL_URL=http://127.0.0.1:9000
