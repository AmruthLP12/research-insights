# ==============================================================================
# RRI Publications Dashboard (.env.example)
# Copy this file to .env and adjust values for your environment.
# Never commit real secrets or production .env files to version control.
# ==============================================================================

# --- Core Django Security & Environment Settings ---

# DEBUG: Explicit boolean flag ('True' for local development, 'False' in production).
# Defaults to False if unset or empty.
DEBUG=True

# DJANGO_SECRET_KEY: Cryptographic signing secret.
# In production (DEBUG=False): REQUIRED. Must be a secure, random string (min 50 chars)
# and must NOT start with 'django-insecure-'.
# In development (DEBUG=True): A fixed development key is acceptable (e.g. this placeholder or the built-in local dev fallback).
DJANGO_SECRET_KEY=django-insecure-development-placeholder-change-in-production

# ALLOWED_HOSTS: Comma-separated list of host/domain names this site can serve.
# In production (DEBUG=False): REQUIRED. Must be explicitly specified (e.g. 'example.com,www.example.com').
# Wildcards ('*') are strictly rejected in production.
# In development (DEBUG=True): Defaults to 'localhost,127.0.0.1,[::1]' if empty.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],example.com

# --- HTTPS & Cookie Security (Production Settings) ---
# In development (DEBUG=True), cookies and redirects remain disabled for plain HTTP.
# In production (DEBUG=False), secure cookies default to True unless explicitly overridden.
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
# Set USE_X_FORWARDED_PROTO=True ONLY when behind a trusted reverse proxy (e.g. Nginx, ALB) that sets X-Forwarded-Proto
USE_X_FORWARDED_PROTO=False

# --- Email Configuration (Password Resets & Notifications) ---
# In development (DEBUG=True): Defaults to console backend (prints emails to terminal).
# In production (DEBUG=False): Defaults to SMTP backend.
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@rri.res.in
SERVER_EMAIL=noreply@rri.res.in

# --- File Uploads & Ingestion Limits ---
# Maximum memory buffer size for uploaded files in bytes before streaming to disk (default: 5242880 = 5 MB)
FILE_UPLOAD_MAX_MEMORY_SIZE=5242880
# Maximum size in bytes of request body before RequestDataTooBig is raised (default: 5242880 = 5 MB)
DATA_UPLOAD_MAX_MEMORY_SIZE=5242880
# Maximum file size in bytes accepted for Web of Science exports (default: 5242880 = 5 MB)
MAX_WOS_FILE_SIZE=5242880
# Maximum publication records accepted per Web of Science upload batch (default: 500)
MAX_WOS_RECORDS=500

# --- Application Server & Build Settings (Used by Makefile / Local Server) ---
PORT=9000
HOST=0.0.0.0
DOMAIN=example.com
SITE_NAME=pub
VENV=venv

# --- Metadata / Deployment Information ---
APP_ENV=Development
APP_VERSION=1.0.0
BUILD_DATE=30-01-2026
SITE_FULL_URL=http://127.0.0.1:9000
